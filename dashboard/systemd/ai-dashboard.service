# ai-dashboard.service — SPEC.md §2.5, INSTALL-SPEC.md §7.
#
# Installed to /etc/systemd/system/ai-dashboard.service by `dashboard.sh unit`, which
# copies THIS file rather than generating one. One producer: the `docker run` line below is
# the only copy of the container's flags anywhere in this project, so nothing can drift
# from it.
#
# ⚠ Nothing that serves or cools may gain a `Wants=` or `After=` naming this unit (§2.3).
# If the dashboard fails, nothing else notices — that is the whole design.

[Unit]
Description=ai-server dashboard (SPEC.md §2.5)
# ⚠ NOT the env file. `Documentation=` is what `systemctl status` invites you to open, and
# /etc/ai-dashboard.env is 0640 root:10001 because it carries a password hash and a session
# secret, and since 2026-09-11 it is MOUNTED into the container rather than copied into its
# environment (SPEC.md §5.1) — the one file on this box nobody should be pointed at.
# The flags below, and the reason for
# each of them, are in THIS file; INSTALL-SPEC §7 is the specification behind it.
Documentation=file:/etc/systemd/system/ai-dashboard.service
Wants=docker.service

# ⚠ TRAP 2, and this repo has already paid for it in full. NEVER `After=multi-user.target`.
# This unit is `WantedBy=multi-user.target`, so ordering it after that target is a CYCLE,
# and systemd breaks a cycle by SILENTLY DELETING a start job — which is how both
# llama-server instances failed to come up on the 2026-08-28 boot with no failed unit and
# no error anywhere except one journal line. `systemctl restart` can never reproduce it;
# it exists only while the target is doing the starting. `dashboard.sh check` runs
# `journalctl -b | grep "ordering cycle"` for exactly this.
After=docker.service sysinit.target

# ⚠ TRAP 1. StartLimitIntervalSec and StartLimitBurst belong in [Unit], NOT [Service].
# systemd moved them in v229 and IGNORES them in [Service], falling back to a 10 s window
# that RestartSec=10 can never fill — so a broken instance retries for ever with nothing
# saying so. Writing them here is not evidence they took: `dashboard.sh unit` asks
# `systemctl show ai-dashboard -p StartLimitIntervalUSec` afterwards, and `check` repeats it.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# ⚠ O22 — one process, one cache. A second instance means a second 2 s telemetry cache, a
# doubled nvidia-smi fork rate, `DELETE /api/session` silently failing for requests that
# land on the other process, and §5's GLOBAL rate limit becoming N× looser. Nothing in the
# test suite can see any of it. Three things make a second instance impossible here, and
# they fail in different directions on purpose:
#   · `--name ai-dashboard`  — Docker refuses a second container with the same name;
#   · `--network host` on a fixed port — a second listener cannot bind 8090 (EADDRINUSE);
#   · this ExecStartPre — a STALE container cannot block a restart either.
# `dashboard.sh check` then asks docker how many are actually running, because writing the
# config is not evidence it took.
ExecStartPre=-/usr/bin/docker rm -f ai-dashboard

# ⚠ THE GPU FALLBACK (INSTALL-SPEC §11.1). `--gpus all` on a box whose toolkit or driver is
# broken makes `docker run` FAIL, and the unit then never starts — the WHOLE dashboard down,
# including the eight panels that need no GPU. The collector half already handles a missing
# card correctly (an errors[] entry and the GPU panels' no-readings state, §3.1 invariant 5),
# so the ruling is: try the GPU, and start without it rather than not at all.
#
# Four things about this shape, each of which is a way to get it wrong:
#
#  1. ⚠ ONE ExecStart=. systemd accepts several only for Type=oneshot; on this Type=simple
#     unit a second one makes the file FAIL TO LOAD ("Service has more than one ExecStart=
#     setting"). That is not a fallback, it is a unit that will not start at all.
#  2. ⚠ `$GPU_FLAGS`, NEVER `${GPU_FLAGS}`. systemd splits the unbraced form on whitespace
#     and passes the braced form as a SINGLE argv — and `--gpus all` as one argument is
#     rejected by docker. The two spellings look identical in review.
#  3. ⚠ The probe does NOT run this repository's own image. `docker run --rm --gpus all
#     ai-dashboard:latest true` would be a second container of this app: `check`'s O22 row
#     matches by repository AND by `--filter ancestor=`, so a check racing a start would
#     report a false second instance. `nvidia-container-cli info` asks the toolkit and the
#     driver — the two coupled things — and starts nothing.
#  4. ⚠ `EnvironmentFile=-` swallows its own absence: a missing file yields an empty
#     GPU_FLAGS, i.e. THE FALLBACK, silently. That is tolerable only because the mode is
#     reported: `check` reads .HostConfig.DeviceRequests off the running container and
#     re-probes, so "fallback while the toolkit works — restart to recover" is a FAILING row
#     rather than a permanent quiet degradation. Never infer the mode from this file's text,
#     which always says $GPU_FLAGS, nor from `gpus: null` in the telemetry, which is also
#     what a box with no compute card reports — and this box documents having none.
ExecStartPre=/bin/sh -c 'if nvidia-container-cli info >/dev/null 2>&1; then echo GPU_FLAGS=--gpus all; else echo GPU_FLAGS=; fi >/run/ai-dashboard-gpu.env'
EnvironmentFile=-/run/ai-dashboard-gpu.env

# ⚠ STANDING, and ONLY STANDING, lifted out of the credentials file (SPEC.md §5.1's ruling of
# 2026-09-11). Since that ruling the two SECRETS are no longer passed as environment
# variables at all — the file is bind-mounted and the server parses it — but §6.4's STANDING
# list stays one, because it is configuration rather than a secret and `lib/telemetry/source.ts`
# reads it from the environment.
#
#  · `grep` emits at most the one line. The password hash and the session secret never enter
#    this file, this unit's environment, or `docker inspect`.
#  · `tail -n 1` is Docker's own rule for a repeated key, kept so that lifting the value out
#    cannot change which one wins.
#  · `|| true` because grep exits 1 on no match, which under systemd's default would FAIL the
#    unit for the entirely normal case of an operator who has set nothing standing.
#  · ⚠ systemd's EnvironmentFile grammar is not Docker's — it STRIPS quotes where Docker keeps
#    them. `dashboard.sh check` already refuses a quoted value on any line of the credentials
#    file, so the two cannot disagree on a file that passes `check`; it is written down here
#    because the divergence is invisible and the check is what closes it.
ExecStartPre=/bin/sh -c 'grep -E "^STANDING=" /etc/ai-dashboard.env | tail -n 1 >/run/ai-dashboard-standing.env || true'
EnvironmentFile=-/run/ai-dashboard-standing.env

# ⚠ Every flag is SPEC.md §2.5 / §2.2. Do not add one without reading INSTALL-SPEC §7's
# table — three of these are load-bearing in a way that is invisible if you get them wrong:
#
#   --network host   NOT -p 8090:8090. Publishing inserts rules into DOCKER/FORWARD, which
#                    are evaluated BEFORE ufw's INPUT — the port becomes reachable from
#                    anywhere routable whatever ufw says. On a box whose firewall was found
#                    silently not enforcing once, a second firewall-invisible listener is
#                    not acceptable. Host networking also gives /proc/net/dev for eno1.
#   --read-only      no next/image, no runtime cache, nothing writable but the tmpfs.
#   --pid host       /proc/stat, /proc/meminfo, /proc/loadavg, /proc/net/dev (§2.2).
#   $GPU_FLAGS       ⚠ `--gpus all`, or NOTHING — see the probe above. Needs
#                    nvidia-container-toolkit ON THE HOST; if the toolkit or the driver
#                    breaks, `docker run --gpus all` FAILS and the whole dashboard would be
#                    down, including the eight panels that need no GPU, exactly when an
#                    operator most wants to look at it. INSTALL-SPEC §11.1 rules that it
#                    FALLS BACK instead. `check` prints the toolkit and driver versions side
#                    by side because they are coupled (§7 risk 2), and reports which mode is
#                    actually in force.
#   UV_THREADPOOL_SIZE=16  libuv's default of 4 is below collectHost's nine concurrent
#                    reads on a healthy poll. Margin behind §4's outstanding-call rule,
#                    never a substitute for it.
#   -e STANDING      ⚠ the PASS-THROUGH spelling: no `=`, so docker takes the value from THIS
#                    unit's environment, which the ExecStartPre above filled from the
#                    credentials file. An operator who has set nothing leaves the variable
#                    unset and docker then sets nothing, which `readStandingList` reads as the
#                    empty list. A STANDING change still needs `dashboard.sh restart`, not a
#                    poll (§4).
#   -v /etc/ai-dashboard.env
#                    ⚠⚠ THE CREDENTIALS, MOUNTED — SPEC.md §5.1's ruling of 2026-09-11
#                    (11-Q2). This line REPLACED `--env-file /etc/ai-dashboard.env`, which
#                    copied PASSWORD_HASH and SESSION_SECRET into the container's environment
#                    where `docker inspect` shows them to every member of the `docker` group
#                    and /proc/1/environ shows them to root. The same trade this repo already
#                    refuses one directory up: serve-llm.sh uses `--api-key-file`, never
#                    `--api-key`, so a key never appears in `ps`. The server reads the file
#                    itself, ONCE, at startup (`instrumentation.ts` → lib/auth/secret-file.ts)
#                    and REFUSES to start on a quoted, padded, multi-line, CRLF or BOM-bearing
#                    value, naming the key and the reason and never the value. `check` asserts
#                    from the other side that neither key is in `docker inspect`'s Env.
#                    ⚠ The file must be readable by uid 10001: `configure` writes it
#                    root:10001 0640, the same shape as /etc/llama-server.apikey's root:yorman
#                    0640, and `check` asserts that too. 0600 root:root — which SPEC §5 still
#                    says — is unreadable to a container that runs as 10001, and the ruling
#                    that mounts the file is what changed it.
#   no --restart     systemd owns restarts. A Docker restart policy would fight it and
#                    restart outside its control.
ExecStart=/usr/bin/docker run --rm --name ai-dashboard \
    --network host \
    --pid host \
    --read-only --tmpfs /tmp \
    --user 10001:10001 \
    $GPU_FLAGS \
    -e NVIDIA_DRIVER_CAPABILITIES=utility \
    -e UV_THREADPOOL_SIZE=16 \
    -e STANDING \
    --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
    -v /etc/ai-dashboard.env:/etc/ai-dashboard.env:ro \
    -v /sys:/sys:ro \
    -v /:/host/root:ro \
    -v /home:/host/home:ro \
    -v /run/dbus/system_bus_socket:/run/dbus/system_bus_socket:ro \
    -v /etc/llama-server:/etc/llama-server:ro \
    -v /etc/ufw/ufw.conf:/etc/ufw/ufw.conf:ro \
    -v /lib/modules:/lib/modules:ro \
    -v /etc/hostname:/etc/hostname:ro \
    ai-dashboard:latest

# The repo convention: anything that changes state cleans up on every exit path, and the
# unit repeats the cleanup to cover SIGKILL. `docker run --rm` does not remove a container
# whose CLIENT was killed, and a stale `ai-dashboard` would then be the second instance
# ExecStartPre exists to prevent.
ExecStopPost=-/usr/bin/docker rm -f ai-dashboard

# ⚠ ALWAYS, not on-failure — INSTALL-SPEC §11.2's ruling of 2026-09-11 (11-Q1). `docker run`
# exits with the CONTAINER's status and Next's standalone server handles SIGTERM and exits 0,
# so `docker stop ai-dashboard` — or anything else that stops the container out from under
# systemd — left the unit `inactive (dead)` with `Result=success` and systemd did NOT bring it
# back. The dashboard is a MONITOR: it comes back from any exit. `systemctl stop
# ai-dashboard` remains the deliberate way down, and it still is, because systemd does not
# restart a unit it stopped itself.
#
# ⚠ Why this cannot become a restart loop, checked rather than assumed:
#   · StartLimitBurst=5 within StartLimitIntervalSec=300, in [Unit] where systemd reads them,
#     bounds it at five attempts per five minutes — then the unit sits in `failed`, which
#     `dashboard.sh check`'s ActiveState row reports. `Restart=always` changes WHICH exits are
#     retried, never how many times.
#   · ExecStartPre=-/usr/bin/docker rm -f and ExecStopPost=-/usr/bin/docker rm -f are both
#     `-` prefixed, so neither can fail a start or a stop, and neither starts anything: they
#     cannot feed the loop. The one they clear — a stale container holding the name — is the
#     condition that would otherwise make every retry fail identically.
#   · A credentials file the server refuses (SPEC §5.1) exits 1 five times and then stops,
#     rather than restarting for ever with nothing saying so.
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
